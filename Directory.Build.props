<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <LangVersion>latest</LangVersion>
    <NeutralLanguage>en</NeutralLanguage>
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>skeleton</VersionSuffix>
    <!-- Nothing is packed until the first release of this repository. -->
    <IsPackable>false</IsPackable>
    <Authors>FrankenSPO contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/skvorc-dev/FrankenSPO.MiddleTier</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The FrankenSPO build this repository compiles against: a GitHub pre-release, fetched by scripts/fetch-frankenspo.sh. -->
    <FrankenSpoVersion>0.0.1-alpha.poc.5</FrankenSpoVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src/')) or $(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src\'))">
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src/')) or $(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src\'))">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
