<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- FrankenSPO pre-release packages, downloaded and checksum-verified by scripts/fetch-frankenspo.sh. -->
    <add key="frankenspo" value=".packages" />
  </packageSources>
  <!-- Sferix.SPO.* only ever comes from the verified local folder, never from a public feed (no dependency confusion). -->
  <packageSourceMapping>
    <packageSource key="frankenspo">
      <package pattern="Sferix.SPO.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
